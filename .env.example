# =================================================================
# ERSMS Environment Configuration Template
# Do NOT commit actual secrets or credentials to source control.
# =================================================================

NODE_ENV=development
PORT=5000

# MongoDB Connection (Local or Atlas SRV)
MONGODB_URI=mongodb://localhost:27017/ersms

# JWT Authentication Secrets (Generate secure random 32+ character strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging & Background Cron Jobs
LOG_LEVEL=info
CRON_ENABLED=true
