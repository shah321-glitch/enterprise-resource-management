{
  "name": "enterprise-resource-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Resource & Subscription Management System (ERSMS)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client && node scripts/copy-dist.js",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client && node scripts/copy-dist.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "eslint .",
    "seed": "npm run seed --workspace=server"
  },
  "keywords": [
    "enterprise",
    "resource-management",
    "subscriptions",
    "mern",
    "api-credits",
    "expenses"
  ],
  "author": "ERSMS Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^10.13.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  }
}
